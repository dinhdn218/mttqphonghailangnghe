// Prisma schema — Website tuyên truyền MTTQ xã Phong Hải
// Tài liệu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Phân quyền: 3 vai — Quản trị / Biên tập / Duyệt
// ----------------------------------------------------------------------------
enum Role {
  ADMIN // Quản trị: toàn quyền, quản lý user + cấu hình
  EDITOR // Biên tập: soạn/sửa bài, gửi duyệt
  APPROVER // Duyệt: duyệt hoặc trả lại bài trước khi đăng
}

// Luồng kiểm duyệt: DRAFT -> PENDING -> (PUBLISHED | REJECTED)
enum PostStatus {
  DRAFT // Bản nháp, biên tập đang soạn
  PENDING // Chờ duyệt
  PUBLISHED // Đã duyệt & đăng công khai
  REJECTED // Bị trả lại, cần sửa
}

enum MediaType {
  IMAGE
  VIDEO
  INFOGRAPHIC
}

// ----------------------------------------------------------------------------
// Người dùng + các model chuẩn của Auth.js (NextAuth)
// ----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Mật khẩu băm (bcrypt) cho đăng nhập credentials. Null nếu chỉ dùng OAuth.
  passwordHash  String?
  role          Role      @default(EDITOR)

  accounts      Account[]
  sessions      Session[]
  authoredPosts Post[]    @relation("AuthoredPosts")
  reviewedPosts Post[]    @relation("ReviewedPosts")
  uploadedMedia Media[]   @relation("UploadedMedia")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Chuyên mục — phân loại cho khuôn Post dùng chung (11 chuyên mục)
// Song ngữ: hậu tố Vi / En
// ----------------------------------------------------------------------------
model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameVi String
  nameEn String?
  descVi String?
  descEn String?
  order  Int     @default(0)

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Bài viết — khuôn chung cho hầu hết chuyên mục. Nội dung HTML do Tiptap sinh.
// Song ngữ Vi (bắt buộc) – En (tuỳ chọn).
// ----------------------------------------------------------------------------
model Post {
  id         String     @id @default(cuid())
  slug       String     @unique
  titleVi    String
  titleEn    String?
  excerptVi  String?
  excerptEn  String?
  contentVi  String // HTML từ Tiptap
  contentEn  String?
  coverImage String? // URL ảnh đại diện (Cloudinary)
  featured   Boolean    @default(false) // bài nổi bật (hiển thị khối đầu trang chủ)
  status     PostStatus @default(DRAFT)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation("AuthoredPosts", fields: [authorId], references: [id])

  // Người duyệt (vai APPROVER) + ghi chú khi trả lại
  reviewedById  String?
  reviewedBy    User?   @relation("ReviewedPosts", fields: [reviewedById], references: [id])
  reviewNote    String?

  publishedAt DateTime?
  media       Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, categoryId])
  @@index([categoryId, publishedAt])
  @@index([status, featured, publishedAt])
}

// ----------------------------------------------------------------------------
// Media — ảnh / video / infographic lưu trên Cloudinary
// ----------------------------------------------------------------------------
model Media {
  id       String    @id @default(cuid())
  url      String
  publicId String // Cloudinary public_id (để xoá/biến đổi)
  type     MediaType @default(IMAGE)
  alt      String?
  width    Int?
  height   Int?

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedMedia", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}
