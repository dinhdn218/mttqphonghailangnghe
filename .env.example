# ============================================================
# Biến môi trường — sao chép file này thành .env và điền giá trị
# ============================================================

# PostgreSQL (Prisma). Ví dụ local: postgresql://postgres:postgres@localhost:5432/bachalangnghe?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bachalangnghe?schema=public"

# Auth.js — tạo secret: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""

# Cloudinary (lưu trữ ảnh/video). Lấy ở dashboard Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Dùng cho next-cloudinary phía client (upload widget) — cloud name + api key công khai
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# Resend — gửi email form "Lắng nghe dân nói"
RESEND_API_KEY=""
CONTACT_INBOX_EMAIL=""
RESEND_FROM="MTTQ Bắc Hà <onboarding@resend.dev>"

# Cloudflare Turnstile (captcha) — tuỳ chọn; trống thì form chỉ dùng honeypot
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# URL gốc của site (cho sitemap, robots, OG). Đổi khi deploy thật.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed tài khoản admin ban đầu (đổi mật khẩu ngay sau khi bàn giao!)
SEED_ADMIN_EMAIL="admin@bachalangnghe.com"
SEED_ADMIN_PASSWORD="Admin@12345"
